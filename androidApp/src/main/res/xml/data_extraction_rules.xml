<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and higher. Sign-in tokens never leave the device (their Keystore key can't). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="tripinly_secure.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="tripinly_secure.xml" />
    </device-transfer>
</data-extraction-rules>
